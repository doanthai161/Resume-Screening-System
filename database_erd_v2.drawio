        </mxCell>

        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK _id: ObjectId&lt;br&gt;UQ email&lt;br&gt;UQ username (partial)&lt;br&gt;UQ phone_number (partial)&lt;br&gt;hashed_password&lt;br&gt;auth_version&lt;br&gt;is_active / is_verified&lt;br&gt;is_superuser&lt;br&gt;verified_at / last_login&lt;br&gt;deleted_at / deleted_by&lt;br&gt;created_at / updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#111827;" vertex="1" parent="1">
