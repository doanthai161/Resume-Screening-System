          <mxGeometry x="660" y="110" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="recruit-label" value="RECRUITMENT PIPELINE" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#C2410C;" vertex="1" parent="1">
