        <mxCell id="title" value="&lt;b&gt;Resume Screening System — Database ERD v2&lt;/b&gt;&lt;br&gt;MongoDB collections, logical foreign keys and main integrity constraints" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = document _id | FK = logical ObjectId reference | UQ = unique/partial unique index&lt;br&gt;Solid connector = active relation | Dashed connector = legacy/generic relation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F9FAFB;strokeColor=#6B7280;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="1800" y="20" width="870" height="70" as="geometry" />
        </mxCell>

