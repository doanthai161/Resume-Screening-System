APP_NAME="Resume Screening System"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
RELOAD=true
# Only proxies in this list may supply Forwarded/X-Forwarded-* headers.
TRUSTED_PROXY_IPS="127.0.0.1"
API_KEY_HEADER="X-API-Key"

SECRET_KEY="your-very-secret-key-at-least-32-chars-long-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72

MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="resume_screening_dev"

REDIS_URL="redis://localhost:6379/0"
REDIS_KEY_PREFIX="resume-screening"
CANDIDATE_CACHE_TTL=300
SCORECARD_CACHE_TTL=600
AUTHZ_CACHE_TTL=60
IDEMPOTENCY_TTL=86400
REDIS_QUEUE_MAX_LENGTH=10000
QUEUE_REDELIVERY_SECONDS=600
MAINTENANCE_INTERVAL_SECONDS=60
MAX_PAGE_SIZE=100
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_CRITICAL_RETENTION_DAYS=365

# Required by docker-compose; use strong, randomly generated values.
MONGO_USERNAME="resume_app"
MONGO_PASSWORD="replace-with-a-strong-random-password"
MONGO_APP_DATABASE="resume_screening_db"
MONGO_APP_USERNAME="resume_api"
MONGO_APP_PASSWORD="replace-with-a-different-strong-random-password"
REDIS_PASSWORD="replace-with-a-strong-random-password"

BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="Resume Screening System"

# SMTP Fallback (uncomment if using SMTP)
# SMTP_TLS=true
# SMTP_PORT=587
# SMTP_HOST="smtp.gmail.com"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# EMAILS_FROM_EMAIL="noreply@yourdomain.com"
# EMAILS_FROM_NAME="Resume Screening System"

OPENAI_API_KEY="your-openai-api-key"
OPENAI_ORGANIZATION="your-org-id"
GEMINI_API_KEY="your-gemini-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-api-key"
AZURE_OPENAI_DEPLOYMENT_NAME="your-deployment-name"
HUGGINGFACE_API_KEY="your-hf-api-key"

MAX_UPLOAD_SIZE=10485760
MAX_RESUME_SIZE=5242880
MAX_DOCX_UNCOMPRESSED_SIZE=52428800
MAX_DOCX_ENTRIES=1000
ALLOWED_RESUME_EXTENSIONS="pdf,docx"
MAX_FILES_PER_UPLOAD=5

USE_S3=false
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_ENDPOINT_URL="https://s3.amazonaws.com"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="100/15minutes"
RATE_LIMIT_UPLOAD="10/hour"
RATE_LIMIT_AUTH="5/minute"
RATE_LIMIT_SCREENING="20/hour"
RATE_LIMIT_WRITE="30/minute"
RATE_LIMIT_READ="120/minute"

CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

LOG_LEVEL="INFO"
LOG_FILE="logs/application.log"

USE_CELERY=false
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="ChangeMe-Strong-2026"
FIRST_SUPERUSER_FULL_NAME="Admin User"
CREATE_FIRST_SUPERUSER=true
